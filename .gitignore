# ==========================================
# Dependencies & Package Managers
# ==========================================
node_modules/
*/node_modules/
.pnp
.pnp.js

# ==========================================
# Environment Variables & Secrets (CRITICAL)
# ==========================================
.env*
*.env*
backend/.env*

# ==========================================
# Production Builds & Compiled Assets
# ==========================================
dist/
dist-ssr/
build/
*.tsbuildinfo

# ==========================================
# Local Database & SQLite Engine Files
# ==========================================
# Database contains encrypted live student submissions
db/*.db
db/*.db-journal
db/*.db-wal
db/*.db-shm
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm
# Keep db folder structure tracked
!db/.gitkeep
!db/.gitignore

# ==========================================
# User Uploads (Student Deliverables)
# ==========================================
# Exclude all uploaded student deliverables (PDF, DOCX, PNG) from git
backend/uploads/assignments/*
!backend/uploads/assignments/.gitkeep
backend/uploads/reports/*
!backend/uploads/reports/.gitkeep
uploads/assignments/*
!uploads/assignments/.gitkeep
uploads/reports/*
!uploads/reports/.gitkeep

# ==========================================
# Logs & Diagnostic Files
# ==========================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ==========================================
# Performance & Load Testing Artifacts
# ==========================================
*.jtl
jmeter.log
coverage/
.nyc_output/

# ==========================================
# Operating System & Editor Files
# ==========================================
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
[Dd]esktop.ini

.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.swo
*~
